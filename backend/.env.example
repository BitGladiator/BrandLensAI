# Frontend development origins (comma-separated). Use exact origins, no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep false until Yuvasri's AI review module is available in the backend environment.
AI_REVIEW_ENABLED=false
AI_REVIEW_MODULE=ai_review
AI_REVIEW_FUNCTION=review_draft
AI_REVIEW_TIMEOUT_SECONDS=15
